# Upload filter for any gcloud upload started from this folder.
.gcloudignore
.git
.gitignore
node_modules/
**/node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
!*.tfvars.example

# Local secret files never leave this machine.
.env
.env.*
**/.env
**/.env.*
**/.env*
!.env.example
!**/.env.example
*.pem
**/*.pem
*.key
**/*.key
