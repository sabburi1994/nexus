{
  "name": "@nexus-agent-framework/tokens",
  "version": "1.0.1",
  "description": "Shared design tokens for the Nexus platform apps: CSS custom properties with light and dark themes per app, Tailwind 3 and 4 presets, typed values and WCAG contrast helpers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./themes/*.css": "./dist/themes/*.css",
    "./tailwind": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.js",
      "require": "./dist/tailwind-preset.cjs"
    },
    "./tailwind4.css": "./dist/tailwind4.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run"
  },
  "keywords": [
    "nexus",
    "design-tokens",
    "css-variables",
    "tailwind",
    "themes",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabburi1994/nexus.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://nexus.abburi.info",
  "bugs": "https://github.com/sabburi1994/nexus/issues",
  "author": "Sai Nikhil Abburi",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
